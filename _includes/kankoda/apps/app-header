{% assign app = include.app %}
{% assign icon = include.icon | default: app.icon %}
{% assign title = include.title | default: app.title | default: app.name %}
{% assign subtitle = include.subtitle | default: app.subtitle %}

<div class="app-header {{ include.class }}">
  {% if icon %}
  <div class="app-header-icon">
    <img class="app-icon" src="{{ icon }}" alt="{{ title }}" />
  </div>
  {% endif %}
  <div class="app-header-text">
    {% if title %}<h2 class="app-header-title">{{ title }}</h2>{% endif %}
    {% if subtitle %}<p class="app-header-subtitle">{{ subtitle }}</p>{% endif %}
  </div>
</div>
